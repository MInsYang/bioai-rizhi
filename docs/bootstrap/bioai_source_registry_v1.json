    "principle": "采集任务每2小时启动一次，但按来源优先级与TTL选择真正需要抓取的来源。"
  },
  "scheduler": {
    "provider": "Cloudflare Workers Cron Triggers",
    "cron_utc": "7 */2 * * *",
    "description": "每个UTC偶数小时的第7分钟启动，避开整点拥堵。Cloudflare Cron使用UTC。",
    "handler": "Worker scheduled() -> signed POST /internal/ingestion/dispatch -> queue fan-out",
    "idempotency_key": "source_id + window_start_utc"
  },
