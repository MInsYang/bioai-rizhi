# Local PostgreSQL for migrations, tests and the exact Worker-handler preview.
DATABASE_URL=postgresql://bioai:replace_me@127.0.0.1:5432/bioai
ADMIN_TOKEN=
# Used only by the optional legacy FastAPI HMAC dispatcher.
INGEST_SECRET=
BIOAI_PREVIEW_PORT=8788
GITHUB_URL=https://github.com/MInsYang/bioai-rizhi
# Cloud production: set DATABASE_URL (Neon) and ADMIN_TOKEN with wrangler secret put.
# Public SITE_ORIGIN / GITHUB_URL belong in Worker vars; see docs/cloudflare-deployment.md.
